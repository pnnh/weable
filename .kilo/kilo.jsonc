{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npx tsc --noEmit*": "allow",
      "npx vitest run": "allow",
      "npx playwright test": "allow"
    }
  }
}