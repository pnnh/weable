{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weable",
  "compatibility_date": "2026-04-20",
  "main": ".open-next/worker.js",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weable-db",
      "database_id": "a6463e67-8911-4c11-814a-aaf5df7e8f82"
    }
  ],
  "vars": {
    // 生产环境通过 wrangler secret put CALIEO_CLIENT_ID 注入
    // wrangler secret put CALIEO_CLIENT_SECRET
    "CALIEO_CLIENT_ID": ""
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "weable-images"
    },
    {
      "bucket_name": "weable-images",           // 可以用同一个 bucket
      "binding": "NEXT_INC_CACHE_R2_BUCKET"   // 必须是这个名字
    }
  ]
}
