{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weable",
  "compatibility_date": "2026-04-20",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "weable.xyz",
      "zone_name": "weable.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weable-db",
      "database_id": "a6463e67-8911-4c11-814a-aaf5df7e8f82",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "CALIEO_CLIENT_ID": "prism_Qgkl2_lHijOgfoJIz3ec9Q"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "weable-images"
    },
    {
      "bucket_name": "weable-images", // 可以用同一个 bucket
      "binding": "NEXT_INC_CACHE_R2_BUCKET" // 必须是这个名字
    }
  ]
}